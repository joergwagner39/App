# Oura Ring Personal Access Token
# Holen unter: https://cloud.ouraring.com/personal-access-tokens
OURA_ACCESS_TOKEN=your_oura_personal_access_token

# Garmin Connect Zugangsdaten
GARMIN_EMAIL=your@email.com
GARMIN_PASSWORD=your_garmin_password

# Ohne diese Variablen läuft die App mit realistischen Demo-Daten

# ---- Trading-Bot ----
# Alpaca PAPER-Trading Keys (Demo-Depot, kein echtes Geld)
# Holen unter: https://app.alpaca.markets/paper/dashboard/overview -> API Keys
ALPACA_API_KEY_ID=your_alpaca_paper_key_id
ALPACA_API_SECRET_KEY=your_alpaca_paper_secret

# Optional: erzeugt zu jedem Trade eine ausführliche Erklärung
# Holen unter: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Ohne diese Variablen läuft der Bot mit simulierten Kursen und Regel-Erklärungen
