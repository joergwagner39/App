# ── Tagebuch "Heute war schön" ───────────────────────────────
# Kennwort für den Abgleich zwischen deinen Geräten. Frei wählbar,
# lang und zufällig. Ohne diese Variable antwortet /api/journal nicht
# und das Tagebuch bleibt rein lokal im Browser.
JOURNAL_TOKEN=ein_langes_zufaelliges_kennwort

# Postgres für die Tagebucheinträge (auf Vercel automatisch gesetzt,
# sobald du eine Postgres-Datenbank mit dem Projekt verbindest).
# Ohne diese Variable landen die Einträge lokal in .journal-data/
DATABASE_URL=postgres://...
