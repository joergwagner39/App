# Oura Ring Personal Access Token
# Holen unter: https://cloud.ouraring.com/personal-access-tokens
OURA_ACCESS_TOKEN=your_oura_personal_access_token

# Garmin Connect Zugangsdaten
GARMIN_EMAIL=your@email.com
GARMIN_PASSWORD=your_garmin_password

# Ohne diese Variablen läuft die App mit realistischen Demo-Daten

# --- Vereinsmatching (/scouting) ---------------------------------------------
# Datenquelle: demo | api-football | sportmonks
SCOUTING_DATA_PROVIDER=demo

# API-Football (dashboard.api-football.com)
# API_FOOTBALL_KEY=
# API_FOOTBALL_SEASON=2025
# API_FOOTBALL_LEAGUE_IDS=78,79,61

# Sportmonks (my.sportmonks.com)
# SPORTMONKS_TOKEN=
# SPORTMONKS_LEAGUE_IDS=82,8

# Ablageort der SQLite-Datenbank (Standard: ./data/scouting.db)
# SCOUTING_DB_PATH=/var/data/scouting.db

# Signierschlüssel für Sitzungs-Cookies. Ohne Angabe wird einmalig einer erzeugt
# und in der Datenbank abgelegt; für den Produktivbetrieb bitte selbst setzen.
# SCOUTING_SESSION_SECRET=
