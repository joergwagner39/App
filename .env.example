# Oura Ring Personal Access Token
# Holen unter: https://cloud.ouraring.com/personal-access-tokens
OURA_ACCESS_TOKEN=your_oura_personal_access_token

# Garmin Connect Zugangsdaten
GARMIN_EMAIL=your@email.com
GARMIN_PASSWORD=your_garmin_password

# Ohne diese Variablen läuft die App mit realistischen Demo-Daten

# ── Coach (/coach) ─────────────────────────────────────────────
# Upstash Redis / Vercel KV (Vercel → Storage → Upstash for Redis verbinden,
# setzt diese Variablen automatisch). Nötig für Handy↔Laptop-Sync und Garmin-Daten.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# PIN, die du auf jedem Gerät im Coach unter „Setup“ eingibst
COACH_PIN=
