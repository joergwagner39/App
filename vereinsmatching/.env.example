# --- ROGON Vereinsmatching ---------------------------------------------------
# Datenquelle: demo | api-football | sportmonks | football-data
SCOUTING_DATA_PROVIDER=demo

# API-Football (dashboard.api-football.com)
# API_FOOTBALL_KEY=
# API_FOOTBALL_SEASON=2025
# API_FOOTBALL_LEAGUE_IDS=78,79,61

# Sportmonks (my.sportmonks.com)
# SPORTMONKS_TOKEN=
# SPORTMONKS_LEAGUE_IDS=82,8

# --- Datenbank ---
# Lokal: nichts setzen, die App legt ./data/scouting.db an.
# SCOUTING_DB_PATH=/eigener/pfad/scouting.db
#
# Produktion (Vercel): Turso ist Pflicht. Auf Vercel ist das Dateisystem nach
# jedem Request wieder weg, eine lokale SQLite-Datei verliert dort alle Daten.
# Beide Werte stehen im Turso-Dashboard bzw. liefert `turso db show` und
# `turso db tokens create`.
# TURSO_DATABASE_URL=libsql://dein-projekt.turso.io
# TURSO_AUTH_TOKEN=

# Signierschlüssel für Sitzungs-Cookies. Ohne Angabe wird einmalig einer erzeugt
# und in der Datenbank abgelegt; für den Produktivbetrieb bitte selbst setzen.
# SCOUTING_SESSION_SECRET=

# football-data.org (football-data.org/client/register)
# Kostenloser Zugang: ausgewählte Wettbewerbe, zehn Abfragen pro Minute.
# Die Bundesliga läuft unter BL1; die 2. Bundesliga ist dort meist nicht enthalten.
# FOOTBALL_DATA_TOKEN=
# FOOTBALL_DATA_COMPETITIONS=BL1
# FOOTBALL_DATA_SEASON=2025
