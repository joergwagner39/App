# Upstash Redis / Vercel KV (Vercel → Storage → „Upstash for Redis“ verbinden)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# PIN, die du auf jedem Gerät einmal eingibst (schützt deine Gesundheitsdaten)
COACH_PIN=

# Oura OAuth-App (https://cloud.ouraring.com/oauth/applications)
# Redirect-URI dort eintragen: https://<deine-domain>/api/oura/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
