{
  "name": "player-crm",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "electron:dev": "concurrently -k \"npm run dev\" \"npx wait-on http://localhost:3001 && electron .\"",
    "electron:build": "cross-env ELECTRON_BUILD=1 next build",
    "dist": "npm run electron:build && electron-builder"
  },
  "dependencies": {
    "date-fns": "^3.0.0",
    "electron-serve": "^1.3.0",
    "lucide-react": "^0.344.0",
    "next": "14.2.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.15.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^38.5.1",
    "electron-builder": "^26.15.3",
    "jimp": "^1.6.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "tv.rogon.playercrm",
    "productName": "Player Relations CRM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "out/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
